{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "tMs": {
      "type": "number",
      "minimum": 0
    },
    "pitchHz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "voice": {
      "enum": [
        "felt",
        "pluck",
        "bow",
        "glass"
      ]
    },
    "gain": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attackSec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "releaseSec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "brightness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pan": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "reverbSend": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "runId",
    "eventId",
    "tMs",
    "pitchHz",
    "voice",
    "gain",
    "attackSec",
    "releaseSec",
    "brightness",
    "pan",
    "reverbSend"
  ],
  "additionalProperties": false
}
